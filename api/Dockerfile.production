ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ARG GORE_REVISION
LABEL org.opencontainers.image.revision=${GORE_REVISION}

WORKDIR /app
COPY requirements.txt /tmp/gore-requirements.txt
RUN pip install --no-cache-dir --disable-pip-version-check -r /tmp/gore-requirements.txt \
    && pip check \
    && find /app -mindepth 1 -maxdepth 1 -exec rm -rf {} +
COPY app /app/app
COPY requirements.txt /app/requirements.txt

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
